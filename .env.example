# 1panel-mcp-v1 —— HTTP 传输配置示例
#
# 复制为 .env.local 后填入真实值（.env.local 已被 .gitignore 排除，不会提交）:
#   cp .env.example .env.local && chmod 600 .env.local

# ── 两个密钥（职责不同，详见 README「两个密钥的分工」）─────────────────
#
# ONEPANEL_API_KEY  面板 API 密钥 —— 只留在本机，客户端永远不需要知道
#                   获取：1Panel → 面板设置 → API 接口 → 生成
#                   别忘了把调用方 IP 加进白名单
#
# MCP_TOKEN         MCP 访问令牌 —— 发给各客户端设备（opencode 等）
#                   生成：openssl rand -hex 32
#
# 推荐两个都设。若只设 MCP_TOKEN，它会同时被当作面板密钥使用，
# 等于把面板管理员密钥交给了每台客户端设备 —— 一台设备被攻破就等于面板被接管。
ONEPANEL_API_KEY=your-panel-api-key
MCP_TOKEN=your-mcp-access-token

# ── 监听地址 ───────────────────────────────────────────────────────────
# 监听非回环地址时必须设置 MCP_TOKEN，否则服务拒绝启动。
# 用 `tailscale ip -4` 查看本机 Tailscale 地址，替换下面的 100.x.y.z。
MCP_HOST=100.x.y.z
MCP_PORT=8790

# ── 1Panel 面板 ────────────────────────────────────────────────────────
# 面板地址请填面板本机监听地址（默认 36437），不要填 Tailscale 地址。
ONEPANEL_HOST=127.0.0.1
ONEPANEL_PORT=36437
ONEPANEL_PROTOCOL=http

# ── 可选 ───────────────────────────────────────────────────────────────
# MCP_PATH=/mcp                    Streamable HTTP 路径
# MCP_MAX_BODY=33554432            请求体上限（默认 32 MiB）
