{
  "name": "1panel-mcp-v1",
  "version": "1.0.0",
  "description": "MCP server for 1Panel V1 (built and verified against v1.10.34-lts) — manage your 1Panel v1 panel through AI agents. Note: this is the V1 edition using the /api/v1 endpoints; it is NOT compatible with 1Panel v2.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "1panel-mcp-v1": "./dist/cli.js",
    "1pmcp-v1": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "1panel",
    "1panel-v1",
    "v1.10.34-lts",
    "model-context-protocol",
    "ai",
    "server-management",
    "cli",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "typescript": "^5.9.3"
  }
}
