[Unit]
Description=1panel-mcp-v1 — 1Panel V1 的 MCP Server（HTTP 传输）
Documentation=https://github.com/ffdkj/1panel-mcp-v1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# __USER__ / __INSTALL_DIR__ 是占位符，安装前必须替换为本机实际值。
# README「长期常驻（systemd）」一节给了自动替换的安装命令。
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_DIR__

# 密钥与监听地址都在这里（该文件已被 .gitignore 排除）
EnvironmentFile=__INSTALL_DIR__/.env.local

ExecStart=/usr/bin/node __INSTALL_DIR__/dist/http.js
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=1panel-mcp-v1

# 加固：服务只需读取自身目录并访问本地面板端口，不需要写文件系统
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
